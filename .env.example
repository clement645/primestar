# Copy this file to .env for local development, or configure the same keys
# as Netlify environment variables (Site configuration → Environment
# variables) for production. Never commit a real .env file.

# ---------------------------------------------------------------------------
# Database — hosted PostgreSQL (Neon recommended; Supabase also supported)
# ---------------------------------------------------------------------------
# Use Neon's POOLED connection string (recommended for serverless functions,
# since each function invocation opens its own short-lived connection and a
# pooler avoids exhausting Postgres' connection limit). Neon's dashboard
# gives you both a pooled URL (host ends in "-pooler") and a direct one.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# The DIRECT (non-pooled) connection string — required for `prisma migrate
# deploy`, since PgBouncer's transaction-pooling mode doesn't support the
# advisory locks migrations need. The app itself never uses this at runtime.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Referral tracking
# ---------------------------------------------------------------------------
# Used to HMAC-hash visitor IP addresses before they ever touch the
# database. Never reuse AUTH_SECRET for this. Generate with:
# openssl rand -base64 32
REFERRAL_HASH_SECRET="replace-with-a-different-long-random-secret"

# ---------------------------------------------------------------------------
# Public site URL (used for referral links, metadata, Open Graph)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"

# ---------------------------------------------------------------------------
# Business contact (also editable later from /admin/settings)
# ---------------------------------------------------------------------------
WHATSAPP_NUMBER="254728623619"
